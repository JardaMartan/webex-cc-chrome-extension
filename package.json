{
  "name": "crm-call-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that injects a Webex Contact Center agent widget (login, call control, click-to-dial) into any CRM web page.",
  "scripts": {
    "prebuild": "node scripts/bump-manifest-version.js",
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "dev": "webpack --mode development",
    "test": "jest",
    "generate-icons": "node scripts/generate-icons.js",
    "package": "npm run build && node scripts/package-zip.js",
    "broker:install": "npm --prefix broker install",
    "broker:start": "npm --prefix broker start"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^12.0.2",
    "crypto-browserify": "^3.12.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "os-browserify": "^0.3.0",
    "pngjs": "^7.0.0",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@momentum-ui/icons": "^8.33.0",
    "@reduxjs/toolkit": "^2.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.0",
    "webex": "^3.12.0"
  }
}
